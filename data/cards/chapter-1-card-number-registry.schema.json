{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gshan1209-cell/Chinese-Idiom-Chain-Game/data/cards/chapter-1-card-number-registry.schema.json",
  "title": "CICG Chapter One Rarity Card Number Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "chapterId", "numberingPolicy", "rarityCounts", "cards"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "chapterId": { "const": "chapter-1" },
    "numberingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "scope",
        "orderBy",
        "sequenceStartsAt",
        "immutableAfterAssignment",
        "reservedRarities"
      ],
      "properties": {
        "format": { "const": "{rarity}-{sequence:000}" },
        "scope": { "const": "within-chapter-per-rarity" },
        "orderBy": { "const": "catalogOrder" },
        "sequenceStartsAt": { "const": 1 },
        "immutableAfterAssignment": { "const": true },
        "reservedRarities": {
          "type": "array",
          "items": { "enum": ["UR"] },
          "uniqueItems": true
        }
      }
    },
    "rarityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["N", "R", "SR", "SSR"],
      "properties": {
        "N": { "const": 12 },
        "R": { "const": 18 },
        "SR": { "const": 23 },
        "SSR": { "const": 8 }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 61,
      "maxItems": 61,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["catalogOrder", "idiomId", "idiomText", "rarity", "cardNumber"],
        "properties": {
          "catalogOrder": { "type": "integer", "minimum": 1, "maximum": 61 },
          "idiomId": { "type": "string", "pattern": "^idiom-[0-9]{4}$" },
          "idiomText": { "type": "string", "minLength": 4, "maxLength": 4 },
          "rarity": { "enum": ["N", "R", "SR", "SSR"] },
          "cardNumber": { "type": "string", "pattern": "^(N|R|SR|SSR)-[0-9]{3}$" }
        }
      }
    }
  }
}
