{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": ".test-dist",
    "skipLibCheck": true
  },
  "include": [
    "src/domain/**/*.ts",
    "src/idioms/**/*.ts",
    "src/game/**/*.ts",
    "src/pwa/**/*.ts",
    "src/puzzle/**/*.ts",
    "src/progress/**/*.ts",
    "src/media/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "node_modules"
  ]
}
